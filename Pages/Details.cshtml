
@page
@model MicroBlog.Pages.DetailsModel
@inject Microsoft.Extensions.Options.IOptions<MicroBlog.Models.SiteOptions> SiteOptions

@{
    ViewData["Title"] = Model.Post?.Title;
}

<div class="container mt-4">
    @if (Model.Post != null)
    {
        <article>
            <h1>@Model.Post.Title</h1>

            <p class="text-muted">
                Posted:
                @Model.Post.CreatedUtc.ToLocalTime()
                    .ToString("f")
            </p>

            <hr />

            <div class="post-body">
                @Model.Post.Body
            </div>
        </article>

        @if (SiteOptions.Value.EnableComments)
        {
<div class="mt-4"> 
    <h3>Leave Comment</h3> 
    <form method="post"> 
        <div class="mb-3"> 
            <label for="comment" class="form-label"> 
                Your comment 
                </label> 
                <textarea id="comment" name="comment" 
                    class="form-control" 
                    rows="4" 
                    placeholder="Write your comment here..." required></textarea> 
                </div>

                <button type ="submit" class="btn btn-primary">
                    Submit Comment
                    </button>
                    </form>
                    </div>
        }
    }

    <a asp-page="/Index"
       class="btn btn-secondary mt-4">
        Back to Posts
    </a>
</div>